# Copy this file to .env.local and fill in your own Supabase project values
# Get them from: Supabase Dashboard > Project Settings > API
# IMPORTANT: use the base project URL, NOT the /rest/v1/ REST endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used for magic-link auth redirect (local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — powers the AI report on the dashboard. Get a free key from
# https://aistudio.google.com/apikey (Google Gemini has a generous free
# tier). Never prefix this with NEXT_PUBLIC_. The feature degrades
# gracefully (clear error message) if left unset.
GOOGLE_GENERATIVE_AI_API_KEY=
