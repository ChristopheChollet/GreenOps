# Copy this file to .env.local and fill in your own Supabase project values
# Get them from: Supabase Dashboard > Project Settings > API
# IMPORTANT: use the base project URL, NOT the /rest/v1/ REST endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used for magic-link auth redirect (local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public GitHub repo URL (landing footer & CTA). Defaults to ChristopheChollet/GreenOps.
NEXT_PUBLIC_REPO_URL=https://github.com/ChristopheChollet/GreenOps

# FlexSlot integration API (service-to-service, étape 5+)
# Secret partagé avec FlexSlot (header X-GreenOps-Service-Key)
GREENOPS_INTEGRATION_SECRET=dev-integration-secret
# Optionnel : limiter l'intégration à une org démo portfolio
# GREENOPS_INTEGRATION_DEMO_ORG_ID=your-org-uuid
# Requis pour l'insert via service role (Supabase > Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# VoltFlow integration (billing microservice, service-to-service)
# Secret partagé avec VoltFlow (header X-VoltFlow-Service-Key)
VOLTFLOW_API_URL=http://localhost:8000
VOLTFLOW_SERVICE_KEY=dev-integration-secret
