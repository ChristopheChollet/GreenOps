# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (racine + sous-dossiers — éviter greenops/node_modules)
node_modules/
greenops/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# Docs personnelles (local / PDF hors GitHub — ne pas pousser)
# mais on garde les captures d'écran, elles doivent être visibles sur GitHub
/docs/*
!/docs/screenshots/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets - never commit), but keep the template
.env
.env.local
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
